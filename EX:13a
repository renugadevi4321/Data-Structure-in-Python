def linear_search(arr, key):
for i in range(len(arr)):
if arr[i] == key:
return i
return -1
def binary_search(arr, key):
low, high = 0, len(arr) - 1
while low <= high:
mid = (low + high) // 2
if arr[mid] == key:
return mid
elif key > arr[mid]:
low = mid + 1
else:
high = mid - 1
return -1
registered = list(map(int, input("Enter registered roll numbers: ").split()))
roll = int(input("Enter roll number to verify: "))
pos = linear_search(registered, roll)
if pos != -1:
print(f"Linear Search : Roll no {roll} is REGISTERED (found at index {pos})")
else:
print(f"Linear Search : Roll no {roll} is NOT registered")
sorted_list = sorted(registered)
print("Sorted list :", sorted_list)
pos = binary_search(sorted_list, roll)
if pos != -1:
print(f"Binary Search : Roll no {roll} is REGISTERED (found at index {pos})")
else:
print(f"Binary Search : Roll no {roll} is NOT registered")
