class stack
{
queue = [None] * 5
front = -1
rear = -1
def enqueue(x):
global front, rear
if rear == 4:
print(&quot;Queue Overflow&quot;)
else:
if front == -1:
front = 0
rear += 1
queue[rear] = x
print(&quot;Inserted:&quot;, x)
def dequeue():
global front, rear
if front == -1 or front &gt; rear:
print(&quot;Queue Underflow&quot;)
else:
print(&quot;Deleted:&quot;, queue[front])
front += 1
def display():
if front == -1 or front &gt; rear:
print(&quot;Queue is Empty&quot;)
else:
print(&quot;Queue:&quot;, queue[front:rear+1])

enqueue(10)
enqueue(20)
enqueue(30)
display()
dequeue()
display()
